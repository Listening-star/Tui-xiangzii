@import '/pixel-sprites-doubao.wxss';

/* ============ 页面：像素草坪主题 ============ */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 12rpx;
  box-sizing: border-box;
  background: #5a9c3a;
}

/* ============ 顶部信息 ============ */
.topbar {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx 10rpx;
  box-sizing: border-box;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7a4a22;
  border: 2rpx solid #5e3617;
  box-shadow: 0 3rpx 0 #5e3617;
}
.back-icon {
  font-size: 48rpx;
  color: #ffe9c7;
  line-height: 1;
  margin-top: -4rpx;
}
.level-name {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff8e7;
  text-shadow: 1rpx 2rpx 0 rgba(0,0,0,.35);
}
.steps {
  min-width: 110rpx;
  text-align: right;
  font-size: 26rpx;
  color: #eaf7d8;
  font-weight: 600;
}

/* ============ 工具栏 ============ */
.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.tool-btn {
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  background: #8a552a;
  color: #fff2dd;
  border: 2rpx solid #5e3617;
  box-shadow: 0 4rpx 0 #5e3617;
}
.tool-btn:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 #5e3617;
}

/* ============ 棋盘 ============ */
.board-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.board {
  box-sizing: content-box;
  overflow: hidden;
  border: 6rpx solid #6d3f1c;
  box-shadow: 0 8rpx 0 #4a2a13;
}
.board-row {
  display: flex;
}
.cell {
  position: relative;
  flex: 0 0 auto;
}
/* 草地：硬边像素点缀（无渐变、无圆角） */
.cell.grass-a {
  background:
    linear-gradient(#6fae3a,#6fae3a) 20% 25% / 8.33% 8.33% no-repeat,
    linear-gradient(#9bd15f,#9bd15f) 70% 70% / 8.33% 8.33% no-repeat,
    #86c24b;
}
.cell.grass-b {
  background:
    linear-gradient(#5f9e32,#5f9e32) 62% 26% / 8.33% 8.33% no-repeat,
    linear-gradient(#8fc753,#8fc753) 28% 72% / 8.33% 8.33% no-repeat,
    #76b23f;
}

/* ============ 精灵基础（角色像素图见 @import） ============ */
.sprite {
  position: absolute;
}
.cell-img {
  width: 100%;
  height: 100%;
}
.sprite-floor {
  background: transparent;
}

/* 树篱墙 / 僵尸 / 植物 / 脑子 的像素图统一在 @import '/pixel-sprites-doubao.wxss' 中定义 */

/* ============ 方向键 ============ */
.dpad {
  margin: 14rpx 0 22rpx;
}
.dpad-row {
  display: flex;
}
.dpad-btn {
  width: 96rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #8a552a;
  color: #fff2dd;
  font-size: 30rpx;
  margin: 6rpx;
  border: 2rpx solid #5e3617;
  box-shadow: 0 5rpx 0 #5e3617;
}
.dpad-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 1rpx 0 #5e3617;
}
.dpad-center {
  background: transparent;
  border: none;
  box-shadow: none;
}
.dpad-center:active {
  transform: none;
}

/* ============ 操纵杆 ============ */
.joystick {
  margin: 14rpx 0 22rpx;
  display: flex;
  justify-content: center;
}
.joy-base {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  background: #6d3f1c;
  border: 6rpx solid #4a2a10;
  box-shadow: inset 0 0 0 12rpx #8a552a, 0 10rpx 0 #4a2a10;
}
.joy-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  height: 120rpx;
  margin: -60rpx 0 0 -60rpx;
  background: #f49abe;
  border: 6rpx solid #d97aa0;
  box-shadow: inset 0 0 0 10rpx #f7b3cc;
  transition: transform .12s ease-out;
}
.joystick.active .joy-knob {
  transition: none;
}
.joy-dir {
  position: absolute;
  color: rgba(255,242,221,.4);
  font-size: 28rpx;
}
.joy-up { top: 18rpx; left: 50%; transform: translateX(-50%); }
.joy-down { bottom: 18rpx; left: 50%; transform: translateX(-50%); }
.joy-left { left: 20rpx; top: 50%; transform: translateY(-50%); }
.joy-right { right: 20rpx; top: 50%; transform: translateY(-50%); }

/* ============ 过关弹窗 ============ */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20,40,10,.62);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.win-dialog {
  width: 600rpx;
  background: #f3e2bd;
  padding: 30rpx 28rpx;
  text-align: center;
  border: 6rpx solid #8a5a28;
  box-shadow: 0 12rpx 0 #5e3617;
}
.eat-banner {
  background: #e2501e;
  border: 5rpx solid #ffca28;
  padding: 26rpx 16rpx;
  box-shadow: inset 0 -6rpx 0 #b33a12;
}
.eat-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1.25;
  text-shadow:
    2rpx 2rpx 0 #b33a12,
    -2rpx 2rpx 0 #b33a12,
    2rpx -2rpx 0 #b33a12,
    -2rpx -2rpx 0 #b33a12,
    0 3rpx 5rpx rgba(0,0,0,.35);
}
.win-steps {
  margin: 22rpx 0 20rpx;
  font-size: 28rpx;
  color: #7a5226;
  font-weight: 600;
}
.win-btns {
  display: flex;
  gap: 14rpx;
  justify-content: center;
}
.win-btn {
  flex: 1;
  padding: 16rpx 0;
  background: #cdb78e;
  color: #5e3f1a;
  border: 2rpx solid #8a5a28;
  font-size: 26rpx;
  font-weight: 600;
}
.win-btn.primary {
  background: #f0a92e;
  color: #5e3a10;
}
