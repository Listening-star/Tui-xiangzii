.about-page {
  min-height: 100vh;
  padding: 30rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 40rpx;
}
.brain-logo {
  position: relative;
  width: 120rpx;
  height: 110rpx;
  background:
    radial-gradient(circle at 41% 56%, #5a2f3f 0 4rpx, transparent 5rpx),
    radial-gradient(circle at 60% 56%, #5a2f3f 0 4rpx, transparent 5rpx),
    radial-gradient(circle at 38% 28%, #fcd5e3, #f49abe);
  border-radius: 52% 48% 50% 46%;
  box-shadow: inset -3rpx -4rpx 8rpx rgba(190,80,120,.4), 0 8rpx 18rpx rgba(0,0,0,.3);
  margin-bottom: 24rpx;
}
.brain-logo::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 22rpx;
  width: 38rpx;
  height: 32rpx;
  border: 2rpx solid #e06a95;
  border-bottom: none;
  border-radius: 50% 50% 0 0;
}
.brain-logo::after {
  content: '';
  position: absolute;
  right: 18rpx;
  top: 42rpx;
  width: 32rpx;
  height: 26rpx;
  border: 2rpx solid #e06a95;
  border-top: none;
  border-radius: 0 0 50% 50%;
}
.app-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff8e7;
}
.version {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #eaf7d8;
}

.section {
  margin-bottom: 36rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe066;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}
.section-body {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4a3418;
  padding: 24rpx 26rpx;
  background: rgba(255,248,225,.94);
  border: 3rpx solid rgba(120,80,35,.3);
  border-radius: 16rpx;
}
.line {
  margin-bottom: 8rpx;
}

/* 图例 */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(255,248,225,.94);
  border: 3rpx solid rgba(120,80,35,.3);
  border-radius: 16rpx;
}
.legend-row {
  display: flex;
  align-items: center;
  width: calc((100% - 20rpx) / 2);
  font-size: 25rpx;
  color: #4a3418;
  font-weight: 600;
}
.legend-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
}
.l-brain {
  background: radial-gradient(circle at 38% 28%, #fcd5e3, #f49abe);
  border-radius: 50%;
}
.l-plant {
  background: radial-gradient(circle at 50% 40%, #7cc97f 0 60%, #43a047 62%);
  border-radius: 50%;
}
.l-zombie {
  background:
    radial-gradient(circle at 34% 40%, #fff 0 12%, transparent 13%),
    radial-gradient(circle at 66% 40%, #fff 0 12%, transparent 13%),
    linear-gradient(160deg, #b3c4a3, #93a786);
  border-radius: 46%;
}
.l-done {
  background: radial-gradient(circle at 50% 40%, #7cc97f 0 60%, #43a047 62%);
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(255,224,102,.95);
}
.l-wall {
  background:
    radial-gradient(circle at 30% 32%, #5aa034 0 22%, transparent 23%),
    radial-gradient(circle at 70% 68%, #438026 0 26%, transparent 27%),
    linear-gradient(135deg, #3e7a24, #2e5e1a);
}

.footer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #eaf7d8;
}
