@import '/pixel-home-doubao.wxss';

.about-page {
  min-height: 100vh;
  padding: 30rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 40rpx;
}
.brain-logo {
  margin-bottom: 24rpx;
}
.app-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff8e7;
}
.version {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #eaf7d8;
}

.section {
  margin-bottom: 36rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe066;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}
.section-body {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4a3418;
  padding: 24rpx 26rpx;
  background: rgba(255,248,225,.94);
  border: 3rpx solid rgba(120,80,35,.3);
}
.line {
  margin-bottom: 8rpx;
}

/* 图例 */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(255,248,225,.94);
  border: 3rpx solid rgba(120,80,35,.3);
}
.legend-row {
  display: flex;
  align-items: center;
  width: calc((100% - 20rpx) / 2);
  font-size: 25rpx;
  color: #4a3418;
  font-weight: 600;
}
.legend-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
}
.l-brain {
  background: #f49abe;
}
.l-plant {
  background: #43a047;
}
.l-zombie {
  background: #93a786;
}
.l-done {
  background: #43a047;
  box-shadow: 0 0 12rpx rgba(255,216,97,.95);
}
.l-wall {
  background: #2e5e1a;
}

.footer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #eaf7d8;
}
