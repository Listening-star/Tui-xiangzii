@import '/pixel-home-doubao.wxss';

.home {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 44rpx;
  box-sizing: border-box;
  background: #5da038;
}

/* 头部 */
.hero {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.brain-logo {
  margin-bottom: 20rpx;
}
.title {
  margin-top: 20rpx;
  font-size: 64rpx;
  font-weight: 800;
  color: #fff8e7;
  letter-spacing: 6rpx;
  text-shadow: 2rpx 3rpx 0 rgba(60,90,30,.6);
}
.subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #eefbdc;
  letter-spacing: 3rpx;
}

/* 菜单 */
.menu {
  margin-top: 70rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
}
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: #f0a92e;
  color: #5e3a10;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  border: 3rpx solid #d98f22;
  box-shadow: 0 8rpx 0 #b9771a;
}
.btn-primary:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #b9771a;
}
.play-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.menu-item {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255,248,225,.92);
  border: 3rpx solid rgba(120,80,35,.35);
  box-shadow: 0 5rpx 0 rgba(90,60,25,.35);
}
.menu-item:active {
  transform: translateY(3rpx);
}
.mi-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
}
.mi-icon-grid {
  background:
    linear-gradient(#5da038,#5da038) 0 0/16rpx 16rpx no-repeat,
    linear-gradient(#5da038,#5da038) 22rpx 0/16rpx 16rpx no-repeat,
    linear-gradient(#5da038,#5da038) 0 22rpx/16rpx 16rpx no-repeat,
    linear-gradient(#5da038,#5da038) 22rpx 22rpx/16rpx 16rpx no-repeat;
}
.mi-icon-gear {
  background: #8a6a3a;
}
.mi-icon-info {
  background: #c98a4a;
}
.mi-label {
  font-size: 30rpx;
  color: #4a3418;
  font-weight: 600;
}
.mi-value {
  margin-left: auto;
  font-size: 26rpx;
  color: #9a7a4a;
  margin-right: 10rpx;
}
.mi-arrow {
  color: #b09060;
  font-size: 40rpx;
}

.footer {
  margin-top: auto;
  margin-bottom: 40rpx;
  padding-top: 40rpx;
  font-size: 22rpx;
  color: #e4f5d0;
  letter-spacing: 2rpx;
}
